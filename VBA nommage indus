Option Explicit

Sub TraiterNommage()

    Dim src As Worksheet ' https://voiesnavigablesdefrance.sharepoint.com/:x:/r/sites/msteams_3356f9_877852-MaintenanceSI-PrimtreDSIN/_layouts/15/Doc.aspx?sourcedoc=%7B74E5DA33-8882-4739-AB4E-8418424630AB%7D&file=Canal%20lat%C3%A9ral%20Garonne%20-%20Plan%20adressage%20Simplifie%20-%20V250131.xlsx&action=default&mobileredirect=true
    Dim dst As Worksheet ' https://voiesnavigablesdefrance.sharepoint.com/:x:/r/sites/msteams_3356f9_877852-MaintenanceSI-PrimtreDSIN/_layouts/15/Doc.aspx?sourcedoc=%7BBBDED183-543C-4CDB-AF28-FBA2951A823A%7D&file=2025-12-15%20-%20Liste%20Supervision%20-%20Gambsheim%20%E2%80%93%20Copie.xlsm&action=default&mobileredirect=true
    Dim map As Worksheet ' https://voiesnavigablesdefrance.sharepoint.com/:x:/r/sites/msteams_3356f9_877852-MaintenanceSI-PrimtreDSIN/_layouts/15/Doc.aspx?sourcedoc=%7B6D4ADB94-007C-4A81-8A6A-381B96456B85%7D&file=VNF%20-%20Convention%20de%20nommage%20Informatique%20Industrielle-v1.0%20%E2%80%93%20Copie.xlsm&action=default&mobileredirect=true
    Dim lastSrc As Long, lastMap As Long, i As Long
    Dim nomComplet As String, nomCourt As String
    Dim partLong As String, partCourt As String
    Dim found As Boolean
    
    ' --- Feuilles Excel ---
    Set src = ThisWorkbook.Sheets("Source")
    Set map = ThisWorkbook.Sheets("Nommage")
    Set dst = ThisWorkbook.Sheets("Destination")
    
    lastSrc = src.Cells(src.Rows.Count, "A").End(xlUp).Row
    lastMap = map.Cells(map.Rows.Count, "A").End(xlUp).Row
    
    dst.Cells.ClearContents
    dst.Range("A1:B1") = Array("IP", "NomCourt")
    
    Dim ligneDst As Long: ligneDst = 2

    ' --- Boucle sur chaque ligne du fichier source ---
    For i = 2 To lastSrc
    
        nomComplet = src.Cells(i, 2).Value
        found = False
        
        ' --- Cherche une correspondance dans la table de nommage ---
        Dim j As Long
        For j = 2 To lastMap
        
            partLong = map.Cells(j, 1).Value
            partCourt = map.Cells(j, 2).Value
            
            If InStr(1, nomComplet, partLong, vbTextCompare) > 0 Then
                ' remplace uniquement la partie longue par la partie courte
                nomCourt = Replace(nomComplet, partLong, partCourt)
                found = True
                Exit For
            End If
        Next j
        
        If Not found Then nomCourt = nomComplet ' si pas de correspondance trouvée
        
        ' --- Écrit dans la destination ---
        dst.Cells(ligneDst, 1).Value = src.Cells(i, 1).Value        ' IP
        dst.Cells(ligneDst, 2).Value = nomCourt                     ' Nom court
        ligneDst = ligneDst + 1
    Next i

    MsgBox "Traitement terminé !", vbInformation

End Sub







