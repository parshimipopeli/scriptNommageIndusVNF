Sub NommageIndus()

    ' Déclaration des variables pour les trois feuilles du fichier
    Dim wsSource As Worksheet
    Dim wsNommage As Worksheet
    Dim wsDest As Worksheet

    ' Variables de comptage
    Dim derniereLigneSource As Long
    Dim derniereLigneNommage As Long
    Dim i As Long, j As Long, k As Long
    Dim ligneDest As Long

    ' Variable de recherche
    Dim trouveNom As Range

    ' Variables chaînes
    Dim nomOuvrage As String
    Dim codeF As String
    Dim valeurJ As String
    Dim adresseIP As String
    Dim codeNomOuvrage As String
    Dim dernierIP As String
    Dim DeuxDernierOctet As String
    Dim ValeurRecherche As String
    Dim ValeurNommage As String
    Dim trigramme As String
    Dim poller As String
    Dim communauteSnmp As String
    Dim domaine As String
    Dim systeme As String
    Dim hote As String
    Dim sys As String

    ' Objets
    Dim regEx As Object
    Dim valeurTrouvee As String

    ' Tableaux
    Dim splitIP As Variant
    
    ' Gestion correspondance
    Dim correspondance As Boolean

    ' Compteur
    Dim id As Long
    id = 1

    ' Variables à adapter en fonction du PCC
    poller = "Poller-PCC_GAMBSHEIM"
    communauteSnmp = "PccGAM"

    ' Liaison feuilles
    Set wsSource = ThisWorkbook.Sheets("Source_GAMBSHEIM")
    Set wsNommage = ThisWorkbook.Sheets("NommageBis")
    Set wsDest = ThisWorkbook.Sheets("Destination")

    ' Première ligne d'écriture
    ligneDest = 2

    ' Dernières lignes
    derniereLigneSource = wsSource.Cells(wsSource.Rows.Count, 1).End(xlUp).Row
    

    ' recherche sur colonne K (IP)
    derniereLigneNommage = wsNommage.Cells(wsNommage.Rows.Count, 11).End(xlUp).Row

    ' Boucle principale source
    For i = 2 To derniereLigneSource

        nomOuvrage = Trim(wsSource.Cells(i, 2).Value)

        If nomOuvrage <> "" Then

            ' Recherche du nom ouvrage colonne H
            Set trouveNom = wsNommage.Columns(8).Find( _
                                What:=nomOuvrage, _
                                LookAt:=xlPart, _
                                MatchCase:=False)

            If Not trouveNom Is Nothing Then

                codeNomOuvrage = wsNommage.Cells(trouveNom.Row, 7).Value
                codeF = wsNommage.Cells(trouveNom.Row, 6).Value
                nomOuvrage = wsNommage.Cells(trouveNom.Row, 8).Value

               ' Recherche trigramme

                Set regEx = CreateObject("VBScript.RegExp")

                regEx.Pattern = "\d+(\.\d+)?"
                regEx.Global = False

                If regEx.Test(nomOuvrage) Then

                    trigramme = Replace(regEx.Execute(nomOuvrage)(0).Value, ".", "")
                    trigramme = Format(CLng(trigramme), "000")

                Else

                    trigramme = GenererTrigramme(nomOuvrage)

                End If
                                
                
                ' Parcours des colonnes IP source
                For j = 6 To 50

                    adresseIP = Trim(wsSource.Cells(i, j).Value)

                    If adresseIP <> "" Then

                        ' Suppression masque réseau
                        adresseIP = Split(adresseIP, "/")(0)

                        ' Découpage IP
                        splitIP = Split(adresseIP, ".")

                        dernierIP = splitIP(3)

                        DeuxDernierOctet = splitIP(2) & "." & splitIP(3)

                        ' Construction clé recherche
                        If splitIP(2) = "14" _
                        Or splitIP(2) = "17" _
                        Or splitIP(2) = "18" _
                        Or splitIP(2) = "19" _
                        Or splitIP(2) = "255" Then

                            ValeurRecherche = DeuxDernierOctet
                            Debug.Print DeuxDernierOctet

                        Else

                            ValeurRecherche = dernierIP
                            Debug.Print dernierIP

                        End If

                        correspondance = False
                        
                       ' Recherche exacte dans la colonne K du nommage
                       For k = 3 To derniereLigneNommage

                        ValeurNommage = Trim(wsNommage.Cells(k, 11).Value)
                        If InStr(1, ValeurNommage, ValeurRecherche, vbTextCompare) > 0 Then

                            'Debug.Print ">>> TROUVE ligne " & k & " : " & ValeurNommage

                        correspondance = True

                                valeurJ = wsNommage.Cells(k, 10).Value
                                domaine = wsNommage.Cells(k, 13).Value
                                systeme = wsNommage.Cells(k, 12).Value

                                hote = Format(codeF, "00") & codeNomOuvrage & valeurJ
                                'Debug.Print hote

                                
                                ' Ecriture feuille Destination
                                
                                
                                
                                wsDest.Cells(ligneDest, 8).Value = UCase(hote)
                                wsDest.Cells(ligneDest, 11).Value = adresseIP
                                wsDest.Cells(ligneDest, 2).Value = Date
                                wsDest.Cells(ligneDest, 5).Value = UCase(nomOuvrage)
                                wsDest.Cells(ligneDest, 6).Value = UCase(domaine)
                                wsDest.Cells(ligneDest, 7).Value = UCase(systeme)
                                wsDest.Cells(ligneDest, 9).Value = trigramme
                                
                                Debug.Print "Trigramme >>>>>>> " & trigramme
                                
                                wsDest.Cells(ligneDest, 10).Value = _
                                    UCase(Format(codeF, "00") & _
                                    codeNomOuvrage & _
                                    valeurJ & "." & _
                                    trigramme & ".V2I")

                                wsDest.Cells(ligneDest, 14).Value = poller
                                wsDest.Cells(ligneDest, 17).Value = communauteSnmp

                                wsDest.Cells(ligneDest, 1).Value = id

                                id = id + 1

                                sys = LCase(systeme)

                                Select Case True

                                    Case InStr(sys, "camera") > 0 _
                                    Or InStr(sys, "caméra") > 0 _
                                    Or InStr(sys, "haut") > 0 _
                                    Or InStr(sys, "interphone") > 0 _
                                    Or InStr(sys, "automate sofrel") > 0

                                        wsDest.Cells(ligneDest, 12).Value = "C3"

                                    Case InStr(sys, "vm") > 0 _
                                    Or InStr(sys, "scada") > 0 _
                                    Or InStr(sys, "archiveur") > 0 _
                                    Or InStr(sys, "automate") > 0

                                        wsDest.Cells(ligneDest, 12).Value = "C1"

                                End Select

                                '==============================
                                ' Mise en forme OK
                                '==============================

                                With wsDest.Range("A" & ligneDest & ":R" & ligneDest)

                                    .Font.Color = RGB(0, 0, 0)
                                    .Font.Bold = True

                                End With



                                ligneDest = ligneDest + 1


                                Exit For


                            End If


                        Next k



                        '===================================
                        ' Aucune correspondance trouvée
                        '===================================

                        If Not correspondance Then


                            wsDest.Cells(ligneDest, 8).Value = _
                                nomOuvrage & " " & adresseIP & _
                                " - Aucune correspondance IP dans nommage !!!"



                            With wsDest.Range("A" & ligneDest & ":R" & ligneDest)

                                .Font.Color = RGB(192, 0, 0)
                                .Font.Bold = True

                            End With



                            ligneDest = ligneDest + 1



                        End If



                    End If



                Next j



            End If



        End If



    Next i



    MsgBox "Traitement terminé. " & _
           (ligneDest - 2) & _
           " ligne(s) écrite(s).", vbInformation

End Sub

Function GenererTrigramme(nomOuvrage As String) As String

    Dim mots() As String
    Dim element As Variant
    Dim trigramme As String

    mots = Split(nomOuvrage, " ")

    For Each element In mots
    

        Select Case LCase(Trim(element))

            Case "ecluse", "écluse", _
                 "barrage", "ouvrage", _
                 "de", "du", "des", _
                 "la", "le", "les"

                ' Ignoré

            Case Else

                trigramme = trigramme & UCase(Left(element, 1))
                

        End Select

    Next element

    GenererTrigramme = Left(trigramme, 3)
    Debug.Print "Résultat final : " & GenererTrigramme

End Function


